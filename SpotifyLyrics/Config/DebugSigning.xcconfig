// Debug-only signing for local ScreenCaptureKit / TCC stability.
// Does NOT apply to Release (Release keeps project ad-hoc until product distribution).
//
// Team ID is NOT committed. Create a sibling file (gitignored):
//   DebugSigning.local.xcconfig
// from DebugSigning.local.xcconfig.example after you have an Apple Development identity.
//
// Optional include: if missing, DEVELOPMENT_TEAM stays empty and Automatic signing will fail
// until the local file exists — that is intentional (no silent ad-hoc fallback).

#include? "DebugSigning.local.xcconfig"

// Single main executable — no SpotifyLyrics.debug.dylib split for TCC.
ENABLE_DEBUG_DYLIB = NO

// Let Xcode Automatic Signing pick Apple Development / Mac Development.
CODE_SIGN_STYLE = Automatic
// Leave identity empty so Automatic can resolve the right cert for macOS.
CODE_SIGN_IDENTITY =

// DEVELOPMENT_TEAM must be set in DebugSigning.local.xcconfig
